[
  {"name": "empty", "input": "", "expected": ""},
  {"name": "plain text untouched", "input": "backup finished in 12s, 3 files copied", "expected": "backup finished in 12s, 3 files copied"},
  {"name": "url credentials", "input": "connecting to postgres://admin:s3cr3t@db.internal:5432/app failed", "expected": "connecting to postgres://***@db.internal:5432/app failed"},
  {"name": "url credentials https", "input": "GET https://user:pa55@example.com/path", "expected": "GET https://***@example.com/path"},
  {"name": "url credentials two urls", "input": "a http://u1:p1@h1/x b ftp://u2:p2@h2/y", "expected": "a http://***@h1/x b ftp://***@h2/y"},
  {"name": "url without password is kept", "input": "https://example.com/path and ssh://git@github.com/x.git", "expected": "https://example.com/path and ssh://***/x.git"},
  {"name": "url user only colon-less", "input": "postgres://admin@db/app", "expected": "postgres://admin@db/app"},
  {"name": "url credentials password with colon-less port", "input": "redis://:onlypass@cache:6379", "expected": "redis://:onlypass@cache:6379"},
  {"name": "url credentials without scheme is kept", "input": "user:pass@host", "expected": "user:pass@host"},
  {"name": "url credentials with slash in password stops", "input": "http://user:pa/ss@host", "expected": "http://user:pa/ss@host"},
  {"name": "authorization bearer", "input": "Authorization: Bearer abc.def.ghi", "expected": "Authorization: ***"},
  {"name": "authorization basic", "input": "authorization: Basic dXNlcjpwYXNz", "expected": "authorization: ***"},
  {"name": "authorization raw token", "input": "AUTHORIZATION=abcdef123", "expected": "AUTHORIZATION=***"},
  {"name": "authorization no space", "input": "Authorization:secrettoken", "expected": "Authorization:***"},
  {"name": "authorization bearer only", "input": "Authorization: Bearer", "expected": "Authorization: ***"},
  {"name": "authorization bearer trailing spaces", "input": "Authorization: Bearer   tok   next", "expected": "Authorization: ***   next"},
  {"name": "authorization in header dump", "input": "> Host: x\n> Authorization: Bearer eyJhbGciOi\n> Accept: */*", "expected": "> Host: x\n> Authorization: ***\n> Accept: */*"},
  {"name": "bearer standalone", "input": "request sent with bearer xyz123 ok", "expected": "request sent with Bearer *** ok"},
  {"name": "bearer capital", "input": "Bearer abc", "expected": "Bearer ***"},
  {"name": "bearer upper", "input": "BEARER abc", "expected": "Bearer ***"},
  {"name": "bearer mid word is kept", "input": "debearer abc and bearers abc", "expected": "debearer abc and bearers abc"},
  {"name": "bearer without value", "input": "the bearer", "expected": "the bearer"},
  {"name": "password equals", "input": "password=hunter2", "expected": "password=***"},
  {"name": "password colon spaces", "input": "password : hunter2 and more", "expected": "password : *** and more"},
  {"name": "password quoted", "input": "password=\"hunter2\"", "expected": "password=\"hunter2\""},
  {"name": "password stops at comma", "input": "user=bob,password=hunter2,host=db", "expected": "user=bob,password=***,host=db"},
  {"name": "password stops at semicolon", "input": "password=hunter2;next", "expected": "password=***;next"},
  {"name": "password stops at ampersand", "input": "https://x/?password=hunter2&user=bob", "expected": "https://x/?password=***&user=bob"},
  {"name": "password stops at single quote", "input": "'password=hunter2'", "expected": "'password=***'"},
  {"name": "passwd", "input": "passwd=abc", "expected": "passwd=***"},
  {"name": "pwd", "input": "PWD=/home/user", "expected": "PWD=***"},
  {"name": "secret", "input": "client_secret=abc123", "expected": "client_secret=***"},
  {"name": "token", "input": "access_token: abc123", "expected": "access_token: ***"},
  {"name": "api_key underscore", "input": "api_key=abc", "expected": "api_key=***"},
  {"name": "api-key hyphen", "input": "API-KEY=abc", "expected": "API-KEY=***"},
  {"name": "apikey", "input": "apikey=abc", "expected": "apikey=***"},
  {"name": "access_key", "input": "aws_access_key_id=AKIAEXAMPLE", "expected": "aws_access_key_id=***"},
  {"name": "access-key", "input": "access-key=zzz", "expected": "access-key=***"},
  {"name": "accesskey", "input": "accesskey=zzz", "expected": "accesskey=***"},
  {"name": "secret suffix word", "input": "mysecretvalue=abc", "expected": "mysecretvalue=***"},
  {"name": "token prefix word chars", "input": "GITHUB_TOKEN=ghp_abc", "expected": "GITHUB_TOKEN=***"},
  {"name": "word boundary: bare keyword inside longer word", "input": "a-password=x", "expected": "a-password=***"},
  {"name": "key without value", "input": "password is wrong", "expected": "password is wrong"},
  {"name": "key mixed case", "input": "PassWord=Abc", "expected": "PassWord=***"},
  {"name": "kelvin sign is not k", "input": "toKen=abc", "expected": "toKen=abc"},
  {"name": "long s is not s", "input": "ſecret=abc", "expected": "ſecret=abc"},
  {"name": "turkish dotless", "input": "passworıd=abc", "expected": "passworıd=abc"},
  {"name": "email", "input": "contact bob@example.com now", "expected": "contact *** now"},
  {"name": "email plus tag", "input": "bob+tag@mail.example.co.uk", "expected": "***"},
  {"name": "email with dots and hyphen", "input": "first.last-name@sub-domain.example.org", "expected": "***"},
  {"name": "email without dot domain is kept", "input": "user@localhost", "expected": "user@localhost"},
  {"name": "email like git remote", "input": "git@github.com:owner/repo.git", "expected": "***:owner/repo.git"},
  {"name": "two emails", "input": "a@b.co,c@d.io", "expected": "***,***"},
  {"name": "long token 32", "input": "key 0123456789abcdef0123456789abcdef end", "expected": "key *** end"},
  {"name": "long token 31 is kept", "input": "key 0123456789abcdef0123456789abcde end", "expected": "key 0123456789abcdef0123456789abcde end"},
  {"name": "long token with hyphen underscore", "input": "id abcdefghij-klmnopqrstu_vwxyz012345 end", "expected": "id *** end"},
  {"name": "long token 64 hex sha", "input": "sha256 e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "expected": "sha256 ***"},
  {"name": "long token with dot splits below 32", "input": "0123456789abcdef0123456789abcdef.0123456789abcdef", "expected": "***.0123456789abcdef"},
  {"name": "long token inside path", "input": "/var/lib/abcdefghijklmnopqrstuvwxyz0123456789/file", "expected": "/var/lib/***/file"},
  {"name": "long token jwt like", "input": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.dozjgNryP4J3jVmNHl0w5N_XgL0n3I9PlFUP0THsR8U", "expected": "***.eyJzdWIiOiIxMjM0NTY3ODkwIn0.***"},
  {"name": "cb agent key", "input": "using key cb_agent_AbCdEfGhIjKlMnOpQrStUvWxYz0123456789", "expected": "using key ***"},
  {"name": "long token unicode neighbours", "input": "éabcdefghijklmnopqrstuvwxyz0123456789é", "expected": "é***é"},
  {"name": "whitespace vertical tab", "input": "password=\u000bsecret", "expected": "password=\u000b***"},
  {"name": "whitespace vertical tab after authorization", "input": "authorization:\u000bfoo\u000bbar", "expected": "authorization:\u000b***\u000bbar"},
  {"name": "nbsp is not whitespace", "input": "password=a b c", "expected": "password=*** c"},
  {"name": "multi line log", "input": "2026-10-11 02:00:01 start\npassword=hunter2\n2026-10-11 02:00:02 done by ops@example.com", "expected": "2026-10-11 02:00:01 start\npassword=***\n2026-10-11 02:00:02 done by ***"},
  {"name": "crlf", "input": "token=abc\r\nnext=1\r\n", "expected": "token=***\r\nnext=1\r\n"},
  {"name": "unicode text untouched", "input": "Türkçe çıktı: başarısız — 日本語 🚀", "expected": "Türkçe çıktı: başarısız — 日本語 🚀"},
  {"name": "emoji before secret", "input": "🚀 token=abc", "expected": "🚀 token=***"},
  {"name": "all patterns together", "input": "curl -H 'Authorization: Bearer abc' https://u:p@h/x?api_key=k1&x=1 mail me@x.io id=0123456789abcdef0123456789abcdef", "expected": "curl -H 'Authorization: *** https://***@h/x?api_key=***&x=1 mail *** id=***"},
  {"name": "password in url query then token", "input": "password=a token=b", "expected": "password=*** token=***"},
  {"name": "key value value is already mask", "input": "token=***", "expected": "token=***"},
  {"name": "authorization with equals and spaces", "input": "Authorization  =  Bearer   abc", "expected": "Authorization  =  ***"},
  {"name": "bearer inside authorization is consumed once", "input": "Authorization: Bearer Bearer abc", "expected": "Authorization: *** abc"},
  {"name": "passwordless key names", "input": "passport=abc tokenizer", "expected": "passport=abc tokenizer"},
  {"name": "tab separated", "input": "secret\t=\tvalue", "expected": "secret\t=\t***"},
  {"name": "colon without value at end", "input": "secret:", "expected": "secret:"},
  {"name": "json style", "input": "{\"password\":\"hunter2\",\"user\":\"bob\"}", "expected": "{\"password\":\"hunter2\",\"user\":\"bob\"}"},
  {"name": "json style token", "input": "{\"access_token\": \"abc123\"}", "expected": "{\"access_token\": \"abc123\"}"},
  {"name": "env dump", "input": "HOME=/root\nDB_PASSWORD=s3cr3t\nPATH=/usr/bin", "expected": "HOME=/root\nDB_PASSWORD=***\nPATH=/usr/bin"}
]
